<Project Sdk="Microsoft.NET.Sdk">

  <!-- 簡易記帳 Android 版(.NET MAUI)。資料層與電腦版共用 ZZZ\Database.cs、ZZZ\DataTransfer.cs -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZZZ.Mobile</RootNamespace>
    <AssemblyName>LedgerMobile</AssemblyName>

    <ApplicationTitle>簡易記帳</ApplicationTitle>
    <ApplicationId>com.asdzzzcoder.ledger</ApplicationId>
    <!-- 版本:CI 依標籤覆寫(ApplicationVersion 是 Android 的 versionCode,必須一直變大:X*10000+Y*100+Z) -->
    <ApplicationDisplayVersion>1.0.23</ApplicationDisplayVersion>
    <ApplicationVersion>10023</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- 備份檔是 Dictionary/List 的 JSON,用反射序列化 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Release 直接輸出 APK(手機下載後點開安裝),不是上架 Google Play 用的 AAB -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <!-- 簽章:CI 由 GitHub Secrets 提供同一把金鑰,這樣新版才能直接覆蓋安裝舊版(資料不會不見) -->
  <PropertyGroup Condition="'$(AndroidSigningKeyStore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ZZZ\Database.cs" Link="Shared\Database.cs" />
    <Compile Include="..\ZZZ\DataTransfer.cs" Link="Shared\DataTransfer.cs" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F2937" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F2937" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
